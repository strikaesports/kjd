[Unit]
Description=KJD Desktop Environment 3D Shell (Phase 0)
Documentation=https://github.com/strikaesports/kjd
After=graphical-session.target
StartLimitBurst=3
StartLimitIntervalSec=30s

[Service]
Type=simple
ExecStart=%h/.local/bin/kjd-session
Restart=on-failure
RestartSec=3s
StandardOutput=journal
StandardError=journal

# Inherit session variables if available
PassEnvironment=WAYLAND_DISPLAY DISPLAY XDG_RUNTIME_DIR XDG_CURRENT_DESKTOP

[Install]
WantedBy=graphical-session.target default.target
